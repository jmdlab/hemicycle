# hemicycle API and scripts — variable names only. Nothing here is a secret;
# the app runs with every value left empty.
PORT=
# Public base URL used for canonical links and the sitemap
SCRUTIN_SITE=
# Start date (YYYY-MM-DD) of the daily pipeline window
SCRUTIN_SINCE=
# Python interpreter of the render virtualenv (scripts/setup-venv.sh)
SCRUTIN_PY=
# "on" enables the optional model pass; leave empty in production
SCRUTIN_LLM=
# Path to the headless LLM CLI wrapper, only used when SCRUTIN_LLM=on
SCRUTIN_CLAUDE_CLI=
